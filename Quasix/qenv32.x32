    cli
    hlt
    jmp panic_die

  
panic_dump_code_region:
  push r1 
  call printf.newline
  call journal.erpref
  ldi  r0, panic_msg3
  ldi  r4, 0
  call printf
  pop  r1
  copy r5, r1
  copy r2, r1  
  sub  r2, 85
  copy r3, r1
  add  r3, 85
  jmp panic_dump_code_region.loop
  
panic_dump_code_region.found_fault_byte:
  push r0 
  ldi  r0, right_brack
  ldi  r4, 0
  call printf
  pop  r0
  ldi  r1, text_pool
  call hex_r0 
  ldi  r0, text_pool  
  add  r0, 6
  ldi  r4, 0
  call printf
  ldi  r0, left_brack
  ldi  r4, 0
  call printf
  ldi  r0, ' '
  call console_emitchar
  jmp  sb_return


panic_dump_code_region.loop:
  add  r4, 1
  rb   r0, [r2]
  push r2 
  push r3 
  push r4
  push r5
  cmp  r2, r5 
  je   panic_dump_code_region.found_fault_byte
  ldi  r1, text_pool
  call hex_r0 
  ldi  r0, text_pool  
  add  r0, 6
  ldi  r4, 0
  call printf
  ldi  r0, ' '
  call console_emitchar
  sb_return:
    pop  r5
    pop  r4
    pop  r3 
    pop  r2
    cmp  r2, r3 
    je   panic_dump_code_region.done
    add  r2, 1
    cmp  r4, 20
    jh   panic_dump_code_region.newline
    jmp  panic_dump_code_region.loop
  
panic_dump_code_region.newline:
  push r2 
  push r3 
  push r4
  push r5
  call printf.newline
  call journal.erpref
  pop  r5
  pop  r4
  pop  r3 
  pop  r2
  ldi  r4, 0
  jmp  panic_dump_code_region.loop

panic_dump_code_region.done:
  ldi r0, panic_msg4
  ldi r4, 1
  call printf

  clf
  ret 

  
