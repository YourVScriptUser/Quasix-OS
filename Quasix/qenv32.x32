kern_entp:
jmp kern_startup

excep_count: db 0

add_excep_count:
  push r0  
  push r1
  ldi r0, excep_count
  rb r1, [r0]
  add r1, 1
  wb [r0], r1
  pop r1 
  pop r0
  ret

reset_excep_count:
  push r0 
  push r1
  ldi r0, excep_count
  ldi r1, 0
  wb [r0], r1
  pop r1 
  pop r0
  ret

; ret r0: Fault count
read_excep_count:
  push r1 
  ldi r0, excep_count
  rb r1, [r0]
  copy r0, r1
  pop r1
  ret 

excep_memory:
  call add_excep_count
  copy r4, r0
  copy r5, r1
  ; the exception return is inside kernel memory / journaler, that means the exception happened inside the kernel, cause a panic if that happens.
  pop r0
  push r1
  ldi r1, 0x00020000
  cmp r0, r1
  copy r0, r4
  copy r1, r5
  jl panic
  pop r1
  push r0
  ; r1 = faulting address (emulator does this)
  call journal.erpref
  copy r0, r1
  ldi r1, text_pool
  call hex_r0
  ldi r1, text_pool
  ldi r0, error_mem
  ldi r4, 1
  call printf
  ; now that the error info has been printed and we know the shell could be in a corrupt state, reload shell.ef
  ldi r7, 0
  ldi r0, shl_file_name
  call qboot_load_ef_file

  jmp shell_loop ; If the error occoured in usermode, maybe GO BACK TO USERMODE INSTEAD OF RETURNING AT THE EXACT ADDRESS THAT THE ERROR OCCOURED
  ; FUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUCCCCCCCCCCCCCCCCCCCCCCCKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK

excep_unknown_opcode:
  call add_excep_count
  copy r4, r0
  copy r5, r1
  ; the exception return is inside kernel memory / journaler, that means the exception happened inside the kernel, cause a panic if that happens.
  pop r0
  push r1
  ldi r1, 0x00020000
