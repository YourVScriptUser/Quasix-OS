autonoexport
origin 0x00060000
db 0xAF, 0xFA
dd 0x00060000
db 0xF0, 0x0D

ldi r0, file_list_prefix
ldi r4, 0
call printf
ldi r0, file_list_loc
ldi r1, ' '
call files_present
ldi r0, file_list_loc
ldi r4, 1
call printf
ldi r0, 136 ; FIX: Color byte was unterminated
call console_emitchar
ret

file_list_prefix:
  db 132, 0

verbose_switch:
  db "v", 0

file_list_loc: